{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.local/codegen/plan.schema.json",
  "title": "OpenCode Code Generation Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "objective",
    "base_revision",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "objective",
          "depends_on",
          "contracts"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/contract"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "final_verification": {
      "type": "object",
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "contract_id",
        "objective",
        "work_class",
        "risk",
        "read",
        "allowed_to_modify",
        "forbidden",
        "requirements",
        "verification",
        "budgets",
        "response"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "work_class": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_to_modify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "commands",
            "invariants"
          ],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_baseline": {
              "enum": [
                "fail",
                "pass"
              ],
              "description": "How the gate must behave on the untouched baseline: fail for new behavior (default), pass for pure refactors."
            }
          },
          "additionalProperties": false
        },
        "budgets": {
          "type": "object",
          "required": [
            "max_builder_attempts",
            "max_contract_revisions",
            "max_unplanned_scope_expansion"
          ],
          "properties": {
            "max_builder_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_contract_revisions": {
              "type": "integer",
              "minimum": 0
            },
            "max_unplanned_scope_expansion": {
              "const": 0
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
